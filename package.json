{
  "name": "martinjc.com",
  "version": "1.0.0",
  "description": "Martin Chorley's personal website",
  "main": "index.js",
  "scripts": {
    "start": "eleventy --serve",
    "build": "cross-env NODE_ENV=production eleventy && npm run build:images",
    "build:images": "node build/images.js",
    "clean": "node -e \"fs.rmSync('public', {recursive: true, force: true})\"",
    "deploy": "npm run build && gh-pages -d public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinjc/martinjc.com.git"
  },
  "author": "Martin Chorley",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/martinjc/martinjc.com/issues"
  },
  "homepage": "https://github.com/martinjc/martinjc.com#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "bibtex-parser-js": "0.0.2",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "sass": "^1.83.4",
    "sharp": "^0.33.5"
  }
}
